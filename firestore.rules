rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the signed-in user an admin?
    // Admin users have a doc at /admins/{uid}. Only set this via the console / Admin SDK.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- Public content: anyone can read, only admins can write ----
    match /siteSettings/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /pages/{doc}          { allow read: if true; allow write: if isAdmin(); }
    match /banners/{doc}        { allow read: if true; allow write: if isAdmin(); }
    match /services/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /staffingSolutions/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /courseCategories/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /courses/{doc}        { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{doc}        { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /news/{doc}           { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{doc}           { allow read: if true; allow write: if isAdmin(); }

    // ---- Form submissions: anyone can CREATE (public forms), only admins can read/update ----
    match /formSubmissions/{doc} {
      allow create: if
        request.resource.data.type is string &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 200;
      allow read, update, delete: if isAdmin();
    }

    // ---- User profiles: a user can read/write only their own doc ----
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ---- Admin registry: never writable from the client ----
    match /admins/{uid} { allow read: if isAdmin(); allow write: if false; }

    // Everything else denied by default.
    match /{document=**} { allow read, write: if false; }
  }
}
